<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Main_Project.styles.css" asp-append-version="true" />
    <link rel="icon"
          type="image/png"
          href="~/Currencies Exchange Rate Application.png"
          asp-append-version="true" />
    <title>@ViewData["Title"] - Currency Exchange</title>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="header-logo">
                    <img src="~/Currencies Exchange Rate Application.png"
                         alt="Currency Exchange Logo" />
                </div>

                <a class="navbar-brand" asp-area="" asp-controller="ExchangeRate" asp-action="Index"><strong>Currencies Exchange Rate App</strong></a>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer justify-content-md-center text-muted">
        <div class="container text-center" >
            <strong>&copy; 2026 - Currencies Exchange Rate App</strong>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>

    .header-logo img {
        width: 75px;
        height: 75px;
        object-fit: contain;
        margin-right: 10px;
    }

</style>
